[Unit]
Description=scratchlm Gradio demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/scratchlm
Environment=GRADIO_SERVER_NAME=0.0.0.0
Environment=GRADIO_SERVER_PORT=7860
Environment=GRADIO_ANALYTICS_ENABLED=False
ExecStart=/opt/scratchlm/.venv/bin/python /opt/scratchlm/app/demo.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
